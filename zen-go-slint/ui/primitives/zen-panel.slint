import { ZenTheme } from "../theme.slint";

export component ZenPanel inherits Rectangle {
    in property <string> title;

    border-width: ZenTheme.border-width;
    border-color: ZenTheme.border;
    border-radius: ZenTheme.panel-radius;
    background: ZenTheme.surface-panel;

    Text {
        x: ZenTheme.spacing-large;
        y: ZenTheme.spacing-medium;
        text: root.title;
        color: ZenTheme.accent-active;
        font-family: ZenTheme.font-display;
        font-size: ZenTheme.text-size-heading;
        font-weight: 800;
    }
}
