import { ZenTheme } from "../theme.slint";

export component ZenPanSlider inherits Rectangle {
    in-out property <int> value;
    in property <int> minimum-raw: 2;
    in property <int> maximum-raw: 62;
    in property <bool> enabled: true;
    callback value-changed(int);
    callback value-released(int);

    width: 96px;
    height: 24px;
    border-width: ZenTheme.border-width;
    border-radius: ZenTheme.control-radius;
    border-color: root.enabled ? ZenTheme.border : ZenTheme.state-disabled;
    background: ZenTheme.surface-inset;

    Rectangle {
        x: 7px;
        y: root.height / 2 - 2px;
        width: root.width - 14px;
        height: 4px;
        border-radius: 2px;
        background: ZenTheme.surface-raised;
    }

    Rectangle {
        x: root.track-left + root.track-width * max(0, min(1, (root.value - root.minimum-raw) * 1.0 / max(1, root.maximum-raw - root.minimum-raw))) - 4px;
        y: root.height / 2 - 6px;
        width: 8px;
        height: 12px;
        border-radius: 4px;
        background: root.enabled ? ZenTheme.accent-active : ZenTheme.state-disabled;
    }

    private property <int> last-emitted: -1;
    private property <length> track-left: 7px;
    private property <length> track-width: root.width - 14px;

    // Snapshot updates must reset gesture deduplication against current value.
    changed value => {
        root.last-emitted = root.value;
    }

    TouchArea {
        enabled: root.enabled;
        width: parent.width;
        height: parent.height;
        double-clicked => {
            root.value = 32;
            root.last-emitted = 32;
            root.value-released(32);
        }
        moved => {
            let ratio = max(0.0, min(1.0,
                (self.mouse-x - root.track-left) / max(1px, root.track-width)));
            let next = round(root.minimum-raw + ratio * (root.maximum-raw - root.minimum-raw));
            let bounded = max(root.minimum-raw, min(root.maximum-raw, next));
            if (bounded != root.last-emitted) {
                root.value = bounded;
                root.last-emitted = bounded;
                root.value-changed(bounded);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up) {
                let ratio = max(0.0, min(1.0,
                    (self.mouse-x - root.track-left) / max(1px, root.track-width)));
                let bounded = max(root.minimum-raw, min(root.maximum-raw,
                    round(root.minimum-raw + ratio * (root.maximum-raw - root.minimum-raw))));
                if (bounded != root.last-emitted) {
                    root.value = bounded;
                    root.last-emitted = bounded;
                    root.value-released(bounded);
                }
            }
        }
    }
}
