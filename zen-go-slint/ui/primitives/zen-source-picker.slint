import { ScrollView } from "std-widgets.slint";
import { ChoiceView } from "../view-models.slint";
import { ZenTheme } from "../theme.slint";

export component ZenSourcePicker inherits Rectangle {
    in property <string> selected-label;
    in property <[ChoiceView]> choices;
    in property <int> reset-token: 0;
    in property <bool> enabled: true;
    callback choice-requested(int);

    // Page and selected-strip context changes close transient picker state.
    changed reset-token => { popup.close(); }
    changed enabled => { if (!root.enabled) { popup.close(); } }

    width: 112px;
    height: ZenTheme.control-height;
    border-width: ZenTheme.border-width;
    border-radius: ZenTheme.control-radius;
    border-color: root.enabled ? ZenTheme.border : ZenTheme.state-disabled;
    background: root.enabled ? ZenTheme.surface-panel : ZenTheme.surface-inset;

    TouchArea {
        enabled: root.enabled;
        width: parent.width;
        height: parent.height;
        clicked => { popup.show(); }
    }

    Text {
        x: ZenTheme.spacing-small;
        width: root.width - 26px;
        height: root.height;
        text: root.selected-label;
        color: root.enabled ? ZenTheme.text-primary : ZenTheme.state-disabled;
        font-size: ZenTheme.text-size-small;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: root.width - 18px;
        width: 12px;
        height: root.height;
        text: "▼";
        color: root.enabled ? ZenTheme.accent-active : ZenTheme.state-disabled;
        font-size: ZenTheme.text-size-small;
        vertical-alignment: center;
        horizontal-alignment: center;
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 2px;
        width: root.width;
        // Bound popup to strip content; ScrollView keeps every choice reachable.
        height: min(220px, max(root.height, root.choices.length * (ZenTheme.control-height - 4px) + 4px));
        close-policy: close-on-click-outside;

        Rectangle {
            width: parent.width;
            height: parent.height;
            border-width: ZenTheme.border-width;
            border-radius: ZenTheme.control-radius;
            border-color: ZenTheme.border-active;
            background: ZenTheme.surface-raised;
            clip: true;

            ScrollView {
                width: parent.width;
                height: parent.height;
                horizontal-scrollbar-policy: always-off;
                vertical-scrollbar-policy: as-needed;

                VerticalLayout {
                    width: parent.width;
                    padding: 2px;
                    for choice in root.choices: Rectangle {
                        height: ZenTheme.control-height - 4px;
                        border-radius: ZenTheme.control-radius;
                        background: choice.selected ? ZenTheme.accent-primary : transparent;

                        TouchArea {
                            width: parent.width;
                            height: parent.height;
                            clicked => {
                                root.choice-requested(choice.index);
                                popup.close();
                            }
                        }

                        Text {
                            x: ZenTheme.spacing-small;
                            width: parent.width - ZenTheme.spacing-medium;
                            height: parent.height;
                            text: choice.label;
                            color: choice.selected ? ZenTheme.text-on-accent : ZenTheme.text-primary;
                            font-size: ZenTheme.text-size-small;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}
