import { ZenTheme } from "../theme.slint";

export component ZenTabBar inherits Rectangle {
    in property <[string]> labels;
    in property <int> active-index: 0;
    callback tab-requested(int);

    height: ZenTheme.tab-height;
    border-width: ZenTheme.border-width;
    border-color: ZenTheme.border;
    border-radius: ZenTheme.control-radius;
    background: ZenTheme.surface-inset;

    HorizontalLayout {
        padding: ZenTheme.spacing-small;
        spacing: ZenTheme.spacing-small;

        for label[i] in root.labels: Rectangle {
            horizontal-stretch: 1;
            border-radius: ZenTheme.control-radius;
            background: i == root.active-index ? ZenTheme.accent-primary
                : tab-touch.has-hover ? ZenTheme.surface-raised
                : transparent;

            tab-touch := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.tab-requested(i); }
            }

            Text {
                width: parent.width;
                height: parent.height;
                text: label;
                color: i == root.active-index ? ZenTheme.text-on-accent : ZenTheme.text-muted;
                font-size: ZenTheme.text-size-body;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
