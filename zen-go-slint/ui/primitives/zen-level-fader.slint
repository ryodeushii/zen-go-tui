import { ZenTheme } from "../theme.slint";

export component ZenLevelFader inherits Rectangle {
    in-out property <int> value;
    in property <int> maximum: 90;
    in property <bool> enabled: true;
    callback value-changed(int);
    callback value-released(int);

    width: 28px;
    height: 150px;
    border-width: ZenTheme.border-width;
    border-radius: ZenTheme.control-radius;
    border-color: root.enabled ? ZenTheme.border : ZenTheme.state-disabled;
    background: ZenTheme.surface-inset;

    Rectangle {
        x: 6px;
        y: 6px;
        width: root.width - 12px;
        height: root.height - 12px;
        border-radius: 4px;
        background: ZenTheme.surface-raised;

        Rectangle {
            x: 0px;
            y: parent.height - parent.height * max(0, min(root.maximum, root.value)) / max(1, root.maximum);
            width: parent.width;
            height: parent.height * max(0, min(root.maximum, root.value)) / max(1, root.maximum);
            border-radius: 4px;
            background: ZenTheme.accent-primary;
        }
    }

    Rectangle {
        x: 2px;
        y: root.track-top + root.track-height * (1 - max(0, min(root.maximum, root.value)) / max(1, root.maximum)) - 4px;
        width: root.width - 4px;
        height: 8px;
        border-radius: 4px;
        border-width: ZenTheme.border-width;
        border-color: root.enabled ? ZenTheme.accent-active : ZenTheme.state-disabled;
        background: root.enabled ? ZenTheme.accent-active : ZenTheme.state-disabled;
    }

    private property <int> last-emitted: -1;
    private property <length> track-top: 6px;
    private property <length> track-height: root.height - 12px;

    // Snapshot updates must reset gesture deduplication against current value.
    changed value => {
        root.last-emitted = root.value;
    }

    TouchArea {
        enabled: root.enabled;
        width: parent.width;
        height: parent.height;
        double-clicked => {
            root.value = 0;
            root.last-emitted = 0;
            root.value-released(0);
        }
        moved => {
            let ratio = max(0.0, min(1.0,
                (root.track-top + root.track-height - self.mouse-y) / max(1px, root.track-height)));
            let next = round(ratio * root.maximum);
            let bounded = max(0, min(root.maximum, next));
            if (bounded != root.last-emitted) {
                root.value = bounded;
                root.last-emitted = bounded;
                root.value-changed(bounded);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up) {
                let ratio = max(0.0, min(1.0,
                    (root.track-top + root.track-height - self.mouse-y) / max(1px, root.track-height)));
                let bounded = max(0, min(root.maximum, round(ratio * root.maximum)));
                if (bounded != root.last-emitted) {
                    root.value = bounded;
                    root.last-emitted = bounded;
                    root.value-released(bounded);
                }
            }
        }
    }
}
