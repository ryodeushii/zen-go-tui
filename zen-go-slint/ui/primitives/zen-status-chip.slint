import { ZenTheme } from "../theme.slint";

export component ZenStatusChip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;

    height: ZenTheme.control-height;
    border-width: ZenTheme.border-width;
    border-radius: ZenTheme.control-height / 2;
    border-color: root.active ? ZenTheme.state-connected : ZenTheme.border;
    background: root.active ? ZenTheme.surface-raised : ZenTheme.surface-inset;

    HorizontalLayout {
        padding-left: ZenTheme.spacing-medium;
        padding-right: ZenTheme.spacing-medium;
        spacing: ZenTheme.spacing-small;
        alignment: center;

        dot-slot := Rectangle {
            width: 7px;
            height: parent.height;
            background: transparent;

            Rectangle {
                y: (parent.height - 7px) / 2;
                width: 7px;
                height: 7px;
                border-radius: 4px;
                background: root.active ? ZenTheme.state-connected : ZenTheme.state-disabled;
            }
        }

        Text {
            height: parent.height;
            text: root.label;
            color: root.active ? ZenTheme.text-primary : ZenTheme.text-muted;
            font-size: ZenTheme.text-size-small;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}
