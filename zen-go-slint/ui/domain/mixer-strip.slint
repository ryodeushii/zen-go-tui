import { ChoiceView, MixerStripView } from "../view-models.slint";
import { ZenTheme } from "../theme.slint";
import { ZenLevelFader } from "../primitives/zen-level-fader.slint";
import { ZenMeter } from "../primitives/zen-meter.slint";
import { ZenPanSlider } from "../primitives/zen-pan-slider.slint";
import { ZenSourcePicker } from "../primitives/zen-source-picker.slint";
import { ZenToggleChip } from "../primitives/zen-toggle-chip.slint";

export component MixerStrip inherits Rectangle {
    in property <MixerStripView> strip;
    in property <bool> controls-enabled: false;
    in property <int> context-token: 0;
    in property <[ChoiceView]> assignment-choices;
    callback level-set(int, int);
    callback pan-set(int, int);
    callback link-requested(int);
    callback mute-requested(int);
    callback solo-requested(int);
    callback assignment-requested(int, int);

    width: 116px;
    height: 438px;
    opacity: root.strip.muted ? 0.58 : 1.0;
    border-width: ZenTheme.border-width;
    border-radius: ZenTheme.panel-radius;
    border-color: ZenTheme.border;
    background: ZenTheme.surface-panel;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 62px;
        border-radius: ZenTheme.panel-radius;
        background: transparent;

        VerticalLayout {
            x: ZenTheme.spacing-small;
            y: ZenTheme.spacing-small;
            width: parent.width - 12px;
            height: parent.height - 12px;
            spacing: 2px;
            Text {
                text: "CH " + root.strip.channel;
                color: ZenTheme.text-primary;
                font-size: ZenTheme.text-size-small;
                font-weight: 800;
                horizontal-alignment: center;
            }
            Text {
                text: root.strip.name;
                color: ZenTheme.text-muted;
                font-size: ZenTheme.text-size-small;
                horizontal-alignment: center;
                overflow: elide;
            }
        }
    }

    source-picker := ZenSourcePicker {
        x: 2px;
        y: 68px;
        width: parent.width - 4px;
        selected-label: root.strip.assignment;
        choices: root.assignment-choices;
        reset-token: root.context-token;
        enabled: root.controls-enabled && root.assignment-choices.length > 0;
        choice-requested(index) => { root.assignment-requested(root.strip.channel, index); }
    }

    Text {
        x: 8px;
        y: 106px;
        width: 46px;
        height: 20px;
        text: "Pan " + root.strip.pan;
        color: ZenTheme.text-muted;
        font-size: ZenTheme.text-size-small;
        vertical-alignment: center;
    }

    ZenPanSlider {
        x: 8px;
        y: 128px;
        width: parent.width - 16px;
        enabled: root.controls-enabled;
        value: root.strip.pan-raw;
        value-changed(value) => { root.pan-set(root.strip.channel, value); }
        value-released(value) => { root.pan-set(root.strip.channel, value); }
    }

    Text {
        x: 8px;
        y: 158px;
        width: parent.width - 16px;
        height: 18px;
        text: "PAN 2–62";
        color: ZenTheme.state-disabled;
        font-size: ZenTheme.text-size-small;
        horizontal-alignment: center;
    }

    ZenMeter {
        x: 24px;
        y: 188px;
        width: 18px;
        height: 136px;
        percent: root.strip.meter-percent;
        peak: false;
    }

    Text {
        x: 8px;
        y: 330px;
        width: 46px;
        height: 18px;
        text: root.strip.meter-percent + "%";
        color: ZenTheme.text-muted;
        font-size: ZenTheme.text-size-small;
        horizontal-alignment: center;
    }

    ZenLevelFader {
        x: 62px;
        y: 180px;
        width: 38px;
        height: 144px;
        enabled: root.controls-enabled;
        value: min(root.strip.level-step, 90);
        value-changed(value) => { root.level-set(root.strip.channel, value); }
        value-released(value) => { root.level-set(root.strip.channel, value); }
    }

    Text {
        x: 58px;
        y: 330px;
        width: 48px;
        height: 18px;
        text: root.strip.level-db + " dB";
        color: ZenTheme.accent-active;
        font-size: ZenTheme.text-size-small;
        horizontal-alignment: center;
    }

    HorizontalLayout {
        x: 0px;
        y: 362px;
        width: parent.width;
        height: ZenTheme.control-height;
        spacing: 3px;
        alignment: center;
        if root.strip.linkable: ZenToggleChip {
            min-width: 32px;
            label: "LINK";
            active: root.strip.linked;
            enabled: root.controls-enabled;
            clicked => { root.link-requested(root.strip.channel); }
        }
        ZenToggleChip {
            min-width: 30px;
            label: "S";
            active: root.strip.soloed;
            enabled: root.controls-enabled;
            clicked => { root.solo-requested(root.strip.channel); }
        }
        ZenToggleChip {
            min-width: 30px;
            label: "M";
            active: root.strip.muted;
            enabled: root.controls-enabled;
            clicked => { root.mute-requested(root.strip.channel); }
        }
    }
}
