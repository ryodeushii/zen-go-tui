import { PreampView } from "../view-models.slint";
import { ZenTheme } from "../theme.slint";
import { ZenButton } from "../primitives/zen-button.slint";
import { ZenMeter } from "../primitives/zen-meter.slint";
import { ZenPanel } from "../primitives/zen-panel.slint";
import { ZenToggleChip } from "../primitives/zen-toggle-chip.slint";

export component PreampCard inherits Rectangle {
    in property <PreampView> preamp;
    in property <bool> controls-enabled: false;
    callback gain-adjusted(int, int, int);
    callback mode-requested(int, int);
    callback phantom-requested(int);
    callback phase-requested(int);

    width: 240px;
    height: 124px;
    border-width: ZenTheme.border-width;
    border-radius: ZenTheme.panel-radius;
    border-color: root.preamp.selected ? ZenTheme.border-active : ZenTheme.border;
    background: transparent;

    ZenPanel {
        width: parent.width;
        height: parent.height;
        title: root.preamp.name + " " + root.preamp.mode;
    }

    HorizontalLayout {
        x: 16px;
        y: 42px;
        width: parent.width - 32px;
        height: 66px;
        spacing: 10px;

        ZenMeter {
            width: 16px;
            height: 54px;
            percent: root.preamp.meter-percent;
            peak: false;
        }

        VerticalLayout {
            spacing: 6px;
            horizontal-stretch: 1;
            Text {
                text: "Gain " + root.preamp.gain;
                color: ZenTheme.accent-active;
                font-size: ZenTheme.text-size-body;
                horizontal-alignment: right;
            }
            HorizontalLayout {
                spacing: ZenTheme.spacing-small;
                ZenButton {
                    label: "−";
                    min-width: 30px;
                    enabled: root.controls-enabled;
                    clicked => { root.gain-adjusted(root.preamp.input, root.preamp.gain, -1); }
                }
                ZenButton {
                    label: "+";
                    min-width: 30px;
                    enabled: root.controls-enabled;
                    clicked => { root.gain-adjusted(root.preamp.input, root.preamp.gain, 1); }
                }
                ZenToggleChip {
                    label: "48V";
                    active: root.preamp.phantom;
                    enabled: root.controls-enabled;
                    clicked => { root.phantom-requested(root.preamp.input); }
                }
                ZenToggleChip {
                    label: "PHASE";
                    active: root.preamp.phase-inverted;
                    enabled: root.controls-enabled;
                    clicked => { root.phase-requested(root.preamp.input); }
                }
            }
        }
    }
}
