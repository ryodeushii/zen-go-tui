export global ZenTheme {
    // Warm Hardware surfaces: deep chassis, inset wells, and raised panels.
    out property <color> surface-deep: #171314;
    out property <color> surface-panel: #241b1c;
    out property <color> surface-raised: #302324;
    out property <color> surface-inset: #100d0e;

    // Terracotta and amber provide selection, action, and attention accents.
    out property <color> accent-primary: #d97868;
    out property <color> accent-active: #f0a05f;
    out property <color> accent-attention: #e6b45f;

    out property <color> text-primary: #fff2ec;
    out property <color> text-muted: #b8a49d;
    out property <color> text-on-accent: #241313;
    out property <color> state-connected: #78bf8b;
    out property <color> state-error: #d65b5b;
    out property <color> state-disabled: #655957;
    out property <color> border: #5a4541;
    out property <color> border-active: #e6a083;

    out property <string> font-display: "sans-serif";
    out property <string> font-body: "sans-serif";
    out property <length> text-size-small: 11px;
    out property <length> text-size-body: 13px;
    out property <length> text-size-heading: 16px;
    out property <length> text-size-title: 20px;

    out property <length> spacing-small: 6px;
    out property <length> spacing-medium: 10px;
    out property <length> spacing-large: 16px;
    out property <length> spacing-section: 24px;
    out property <length> panel-radius: 10px;
    out property <length> control-radius: 6px;
    out property <length> border-width: 1px;
    out property <length> control-height: 30px;
    out property <length> tab-height: 38px;
}
