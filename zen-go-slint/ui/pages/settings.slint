import { ZenTheme } from "../theme.slint";
import { ZenButton } from "../primitives/zen-button.slint";
import { ZenToggleChip } from "../primitives/zen-toggle-chip.slint";
import { ZenPanel } from "../primitives/zen-panel.slint";

export component SettingsPage inherits Rectangle {
    in property <bool> controls-enabled: false;
    in property <string> refresh-rate-label;
    in property <string> peak-threshold-label;
    in property <string> peak-hold-label;
    in property <bool> peak-enabled;
    in property <bool> auto-save;
    callback refresh-rate-requested(int);
    callback peak-threshold-adjusted(bool);
    callback peak-enabled-toggled();
    callback peak-hold-requested(int);
    callback auto-save-toggled();

    background: transparent;

    ZenPanel {
        width: parent.width;
        height: parent.height;
        title: "Settings";

        settings-grid := VerticalLayout {
            x: (parent.width - settings-grid.width) / 2;
            y: 48px;
            width: min(parent.width - 48px, 760px);
            height: 184px;
            spacing: ZenTheme.spacing-medium;
            alignment: start;

            HorizontalLayout {
                height: ZenTheme.control-height;
                spacing: ZenTheme.spacing-small;
                alignment: start;
                Text {
                    width: 140px;
                    height: parent.height;
                    text: "Refresh rate";
                    color: ZenTheme.text-primary;
                    font-size: ZenTheme.text-size-body;
                    vertical-alignment: center;
                }
                ZenButton {
                    label: "15 FPS";
                    min-width: 90px;
                    active: root.refresh-rate-label == "15 FPS";
                    enabled: root.controls-enabled;
                    clicked => { root.refresh-rate-requested(0); }
                }
                ZenButton {
                    label: "30 FPS";
                    min-width: 90px;
                    active: root.refresh-rate-label == "30 FPS";
                    enabled: root.controls-enabled;
                    clicked => { root.refresh-rate-requested(1); }
                }
                ZenButton {
                    label: "60 FPS";
                    min-width: 90px;
                    active: root.refresh-rate-label == "60 FPS";
                    enabled: root.controls-enabled;
                    clicked => { root.refresh-rate-requested(2); }
                }
            }

            HorizontalLayout {
                height: ZenTheme.control-height;
                spacing: ZenTheme.spacing-small;
                alignment: start;
                Text {
                    width: 140px;
                    height: parent.height;
                    text: "Peak threshold";
                    color: ZenTheme.text-primary;
                    font-size: ZenTheme.text-size-body;
                    vertical-alignment: center;
                }
                ZenButton {
                    label: "−";
                    min-width: 42px;
                    enabled: root.controls-enabled;
                    clicked => { root.peak-threshold-adjusted(false); }
                }
                Text {
                    width: 90px;
                    height: parent.height;
                    text: root.peak-threshold-label;
                    color: ZenTheme.accent-active;
                    font-size: ZenTheme.text-size-body;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                ZenButton {
                    label: "+";
                    min-width: 42px;
                    enabled: root.controls-enabled;
                    clicked => { root.peak-threshold-adjusted(true); }
                }
            }

            HorizontalLayout {
                height: ZenTheme.control-height;
                spacing: ZenTheme.spacing-small;
                alignment: start;
                Text {
                    width: 140px;
                    height: parent.height;
                    text: "Peak hold";
                    color: ZenTheme.text-primary;
                    font-size: ZenTheme.text-size-body;
                    vertical-alignment: center;
                }
                ZenButton {
                    label: "1s";
                    min-width: 64px;
                    active: root.peak-hold-label == "1s";
                    enabled: root.controls-enabled;
                    clicked => { root.peak-hold-requested(0); }
                }
                ZenButton {
                    label: "3s";
                    min-width: 64px;
                    active: root.peak-hold-label == "3s";
                    enabled: root.controls-enabled;
                    clicked => { root.peak-hold-requested(1); }
                }
                ZenButton {
                    label: "5s";
                    min-width: 64px;
                    active: root.peak-hold-label == "5s";
                    enabled: root.controls-enabled;
                    clicked => { root.peak-hold-requested(2); }
                }
                ZenButton {
                    label: "10s";
                    min-width: 64px;
                    active: root.peak-hold-label == "10s";
                    enabled: root.controls-enabled;
                    clicked => { root.peak-hold-requested(3); }
                }
            }

            HorizontalLayout {
                height: ZenTheme.control-height;
                spacing: ZenTheme.spacing-small;
                alignment: start;
                Text {
                    width: 140px;
                    height: parent.height;
                    text: "Persistence";
                    color: ZenTheme.text-primary;
                    font-size: ZenTheme.text-size-body;
                    vertical-alignment: center;
                }
                ZenToggleChip {
                    min-width: 90px;
                    label: "PEAK";
                    active: root.peak-enabled;
                    enabled: root.controls-enabled;
                    clicked => { root.peak-enabled-toggled(); }
                }
                ZenToggleChip {
                    min-width: 110px;
                    label: "AUTO-SAVE";
                    active: root.auto-save;
                    enabled: root.controls-enabled;
                    clicked => { root.auto-save-toggled(); }
                }
            }
        }
    }
}
