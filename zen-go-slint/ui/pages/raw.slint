import { ScrollView } from "std-widgets.slint";
import { ZenTheme } from "../theme.slint";
import { ZenButton } from "../primitives/zen-button.slint";
import { ZenPanel } from "../primitives/zen-panel.slint";

export component RawPage inherits Rectangle {
    in property <bool> controls-enabled: false;
    in property <string> raw-tab-label;
    in property <string> raw-summary;
    in property <[string]> raw-rows;
    callback raw-capture-baseline-requested();
    callback raw-clear-baseline-requested();
    callback refresh-requested();

    background: transparent;

    ZenPanel {
        width: parent.width;
        height: parent.height;
        title: root.raw-tab-label;

        VerticalLayout {
            x: ZenTheme.spacing-large;
            y: 48px;
            width: parent.width - 32px;
            height: parent.height - 60px;
            spacing: ZenTheme.spacing-medium;

            Text {
                text: root.raw-summary;
                color: ZenTheme.text-muted;
                font-size: ZenTheme.text-size-body;
            }

            HorizontalLayout {
                spacing: ZenTheme.spacing-small;
                ZenButton {
                    label: "Capture Baseline";
                    enabled: root.controls-enabled;
                    clicked => { root.raw-capture-baseline-requested(); }
                }
                ZenButton {
                    label: "Clear Baseline";
                    enabled: root.controls-enabled;
                    clicked => { root.raw-clear-baseline-requested(); }
                }
                ZenButton {
                    label: "Refresh";
                    enabled: root.controls-enabled;
                    clicked => { root.refresh-requested(); }
                }
            }

            ScrollView {
                horizontal-scrollbar-policy: as-needed;
                vertical-scrollbar-policy: as-needed;
                VerticalLayout {
                    spacing: ZenTheme.spacing-small;
                    Text {
                        text: root.raw-rows.length == 0 ? "No query replies captured yet" : "";
                        color: ZenTheme.text-muted;
                        font-size: ZenTheme.text-size-small;
                    }
                    for row in root.raw-rows: Text {
                        text: row;
                        color: ZenTheme.text-muted;
                        font-family: "monospace";
                        font-size: ZenTheme.text-size-small;
                    }
                }
            }
        }
    }
}
